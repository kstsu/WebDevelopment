# Local MongoDB replica set (default for development):
DATABASE_URL="mongodb://127.0.0.1:27018/inventory?replicaSet=rs0&retryWrites=true&w=majority"
# MongoDB Atlas alternative:
# DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority"
NEXT_PUBLIC_DATABASE_ENABLED="true"
