# Browser-only inventory by default. No database needed for login.
NEXT_PUBLIC_DATABASE_ENABLED="false"
# To enable inventory sync later, set the flag to true and supply an Atlas URI:
# DATABASE_URL="mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority"

# App accounts and sessions can use a separate database on the same cluster.
# Grant the server database user readWrite on this database before enabling it.
# AUTH_DATABASE_NAME="naokoffi_accounts_dev"

# Optional one-time owner provisioning when no owner exists. Use a new email
# and a unique password of at least 12 characters. Keep both values server-side.
# AUTH_OWNER_EMAIL=""
# AUTH_OWNER_PASSWORD=""
