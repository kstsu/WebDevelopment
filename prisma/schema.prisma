generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @map("_id")
  name        String    @unique
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Supplier {
  id            String    @id @map("_id")
  name          String
  contactPerson String
  email         String
  phone         String
  address       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@index([name])
}

model Product {
  id              String          @id @map("_id")
  sku             String          @unique
  name            String
  description     String
  categoryId      String
  supplierId      String
  unit            String
  costPriceCents  Int
  sellingPriceCents Int
  quantity        Int
  reorderPoint    Int
  location        String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  movements       StockMovement[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([updatedAt])
}

model StockMovement {
  id            String    @id @map("_id")
  productId     String?
  productName   String
  type          String
  quantity      Int
  resultQuantity Int
  note          String
  date          DateTime
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([date])
}

model AuditLog {
  id           String   @id @map("_id")
  occurredAt   DateTime @default(now())
  actorType    String
  action       String
  subjectType  String
  subjectId    String
  changes      String?
  requestId    String?

  @@index([subjectType, subjectId, occurredAt])
  @@index([occurredAt])
}
